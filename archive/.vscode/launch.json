{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug SFT (Single GPU)",
            "type": "debugpy",
            "request": "launch",
            "module": "accelerate.commands.launch",
            "args": [
                "--num_processes=1",
                "--main_process_port=29500",
                "scripts/sft.py",
                "--task_name", "mol_rep_ocr",
                "--model_name", "qwen3_vl_4b_i",
                "--training_method", "sft_lora"
            ],
            "env": {
                "PYTHONPATH": "${workspaceFolder}/mol-llm",
                "WANDB_MODE": "offline",
                "HF_ENDPOINT": "https://hf-mirror.com"
            },
            "console": "integratedTerminal",
            "justMyCode": false,
            "cwd": "${workspaceFolder}/mol-llm"
        },
        {
            "name": "Debug SFT (Multi GPU - 4)",
            "type": "debugpy",
            "request": "launch",
            "module": "accelerate.commands.launch",
            "args": [
                "--num_processes=4",
                "--main_process_port=29500",
                "scripts/sft.py",
                "--task_name", "mol_rep_ocr",
                "--model_name", "qwen3_vl_4b_i",
                "--training_method", "sft_lora"
            ],
            "env": {
                "PYTHONPATH": "${workspaceFolder}",
                "WANDB_MODE": "offline",
                "HF_ENDPOINT": "https://hf-mirror.com"
            },
            "console": "integratedTerminal",
            "justMyCode": false,
            "cwd": "${workspaceFolder}",
            "subProcess": true
        },
        {
            "name": "Debug SFT (Direct Python - No Accelerate)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/sft.py",
            "args": [
                "--task_name", "mol_rep_ocr",
                "--model_name", "qwen3_vl_4b_i",
                "--training_method", "sft_lora"
            ],
            "env": {
                "PYTHONPATH": "${workspaceFolder}",
                "WANDB_MODE": "offline",
                "HF_ENDPOINT": "https://hf-mirror.com"
            },
            "console": "integratedTerminal",
            "justMyCode": false,
            "cwd": "${workspaceFolder}"
        }
    ]
}
